generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id          String @id @default(uuid())
  name        String
  description String
  users User[]
}

model Manufacturer {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(50)
  phone     String   @unique @db.VarChar(30)
  email     String   @unique @db.VarChar(50)
  adress    String   @db.VarChar(30)
  street    String   @db.VarChar(30)
  number    String   @db.VarChar(15)
  city      String   @db.VarChar(20)
  state     String   @db.VarChar(20)
  zip_code  String   @db.VarChar(20)
  website   String   @db.VarChar(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id            String   @id @default(uuid())
  username      String   @unique @db.VarChar(30)
  password      String   @db.VarChar(30)
  roleId        String   
  phone         String   @unique @db.VarChar(30)
  email         String   @unique @db.VarChar(50)
  address       String   @db.VarChar(30)
  street        String   @db.VarChar(30)
  city          String   @db.VarChar(20)
  country       String   @db.VarChar(15)
  postal_code   String   @db.VarChar(10)
  state         String   @db.VarChar(20)
  date_of_birth DateTime
  gender        String   @db.VarChar(10)
  nationality   String   @db.VarChar(20)
  language      String   @db.VarChar(15)
  role          Role     @relation(fields: [roleId], references: [id])
}